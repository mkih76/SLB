# SLB 生产环境配置模板
# 复制此文件为 .env 并填写实际值

# 安全密钥（部署脚本会自动生成，勿使用默认值）
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_SECRET=change-me-to-another-random-string

# 数据库路径
DATABASE_PATH=data/slb.db

# LLM 配置（也可在管理后台设置页面切换）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Telegram Bot（可选）
TG_BOT_TOKEN=

# Flask 环境
FLASK_DEBUG=false
FLASK_ENV=production
ENV=production
PORT=8790

# CORS（生产环境填实际域名）
# ALLOWED_ORIGINS=https://slb.19990419.top
